# Postgres connection (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/flux_ai?schema=public"

# Secret used to sign JWT auth cookies. REQUIRED — the app refuses to
# authenticate when this is unset. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# Optional: key that encrypts stored proxy API keys at rest (AES-256-GCM).
# Defaults to a key derived from JWT_SECRET. Set a separate long random value
# so rotating JWT_SECRET doesn't orphan stored keys.
# APP_ENCRYPTION_KEY="another-long-random-string"
